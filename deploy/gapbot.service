[Unit]
Description=Gap Bot tick (intraday poll / EOD paper-trading run)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/gap-bot
ExecStart=/bin/bash /home/ubuntu/gap-bot/scripts/gap_bot_tick.sh
# One EOD run pulls daily bars for ~500 tickers sequentially -- generous
# margin over the wheel bot's own measured pull time for a similar count.
# This unit serves both tick modes; this is the EOD ceiling. Intraday
# polls are capped at 240s inside gap_bot_tick.sh (`timeout`), under the
# 5-minute cadence, so a hung quote pull never holds the tick lock across
# polls -- a unit-level value can't differ per mode.
TimeoutStartSec=1800
